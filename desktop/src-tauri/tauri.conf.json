{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "1.0.0",
  "identifier": "io.github.pk1310oo.clipper",
  "build": {
    "frontendDist": "../../docs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clipper",
        "width": 1280,
        "height": 900,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Utility",
    "shortDescription": "Uebersicht der automatischen Clip-Pipeline",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
